# ============================================
# SCHOOL MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ============================================
# DATABASE (MongoDB)
# ============================================
# MongoDB Atlas: Create free cluster at https://www.mongodb.com/cloud/atlas
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/school_db?retryWrites=true&w=majority

# ============================================
# JWT SECRETS (Generate unique for each deployment)
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# SCHOOL CONFIGURATION (For this instance)
# ============================================
SCHOOL_NAME=My School
SCHOOL_LOGO=/uploads/logos/school-logo.png

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Choose ONE provider and configure below

# Provider Options: resend, brevo, mailgun, gmail, smtp
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@yourschool.com
EMAIL_FROM_NAME=School Management System

# --- OPTION 1: Resend (Recommended - 3000 emails/month FREE) ---
# Sign up at: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# --- OPTION 2: Brevo/Sendinblue (300 emails/day FREE) ---
# Sign up at: https://www.brevo.com
# BREVO_USER=your-email@example.com
# BREVO_API_KEY=xkeysib-xxxxxx

# --- OPTION 3: Gmail (500/day with App Password) ---
# Enable 2FA and create App Password at: https://myaccount.google.com/apppasswords
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- OPTION 4: Mailgun (1000 emails free for 3 months) ---
# Sign up at: https://www.mailgun.com
# MAILGUN_USER=postmaster@your-domain.mailgun.org
# MAILGUN_PASSWORD=your-mailgun-password

# --- OPTION 5: Generic SMTP ---
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-username
# SMTP_PASSWORD=your-password

# ============================================
# SECURITY (Optional - Defaults are sensible)
# ============================================
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
# BCRYPT_SALT_ROUNDS=12

# ============================================
# DEPLOYMENT INFO
# ============================================
# For production deployments, set NODE_ENV=production
# and ensure all secrets are unique and secure
